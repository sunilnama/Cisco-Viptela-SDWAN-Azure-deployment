---
- name: Sync Infoblox IPAM data to NetBox (prefixes, IPs, VLANs) + drift create/patch/delete
  hosts: localhost
  gather_facts: false
  connection: local

  vars:
    # ---------- Infoblox host/version normalization ----------
    ib_host: "{{ infoblox_host regex_replace('/+$','') }}"
    ib_wapi_ver: "{{ (infoblox_wapi_version | default('2.11')) regex_replace('^v','') }}"
    ib_base: "{{ ib_host }}/wapi/v{{ ib_wapi_ver }}"

    # ---------- NetBox REST headers ----------
    nb_headers:
      Authorization: "Token {{ netbox_token }}"
      Content-Type: "application/json"

    # ---------- Tunables & toggles ----------
    ib_safe_max_results: 500

    remediate_prefixes: true    # create missing prefixes
    remediate_ips: true         # create missing IPs
    remediate_vlans: true       # create missing VLANs
    patch_prefix_vlan: true     # link prefixes to VLANs (PATCH)

    delete_prefixes_missing_in_infoblox: true   # delete prefixes present in NetBox but not in Infoblox
    delete_vlans_missing_in_infoblox: false     # delete VLANs present in NetBox but not in Infoblox

    # Optional: Constrain VLAN lookup by site (name or slug) if duplicate vids exist across sites.
    # Leave empty or unset if not needed.
    netbox_vlan_site: ""

    # Minimum NetBox version check (optional safeguard)
    min_netbox_version: "3.5"

  tasks:
    ###########################################################################
    # NetBox readiness + version check via API-Version header (normalized)
    ###########################################################################
    - name: Probe NetBox API root (readiness + version header)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
        timeout: 60
        follow_redirects: all
        use_proxy: no
      register: nb_root

    - name: Assert NetBox API is reachable
      ansible.builtin.assert:
        that:
          - nb_root.status == 200
        fail_msg: "NetBox API root not reachable at {{ netbox_url }}/api/"

    # (Keep your existing version normalization logic intact as in your original file)
    - name: Normalize NetBox API-Version header to semver (X.Y.Z)
      ansible.builtin.set_fact:
        nb_api_version_semver: "{{ nb_root.api_version ~ ('.0' if (nb_root.api_version.split('.') length == 2) else '') }}"

    - name: Normalize baseline (min_netbox_version) to semver (X.Y.Z)
      ansible.builtin.set_fact:
        min_nb_semver: "{{ min_netbox_version ~ ('.0' if (min_netbox_version.split('.') length == 2) else '') }}"

    - name: Enforce minimum NetBox version (normalized semver)
      ansible.builtin.assert:
        that:
          - nb_api_version_semver is version(min_nb_semver, '>=')
        fail_msg: "NetBox version too old: got {{ nb_api_version_semver }}, need >= {{ min_nb_semver }}."

    ###########################################################################
    # Infoblox WAPI fetch (NIOS 8.5.x ⇒ v2.11; no redirects)
    ###########################################################################
    - name: Probe WAPI network schema (no redirects)
      ansible.builtin.uri:
        url: "{{ ib_base }}/network?_schema"
        url_username: "{{ infoblox_username }}"
        url_password: "{{ infoblox_password }}"
        force_basic_auth: true
        validate_certs: "{{ infoblox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200, 401]
        timeout: 30
        follow_redirects: none
        use_proxy: no
      register: ib_net_schema

    - name: Get Infoblox networks (CIDRs + VLAN refs) (no redirects)
      ansible.builtin.uri:
        url: "{{ ib_base }}/network?_return_fields=network,vlans&_max_results={{ ib_safe_max_results }}"
        headers: { Accept: "application/json" }
        url_username: "{{ infoblox_username }}"
        url_password: "{{ infoblox_password }}"
        force_basic_auth: true
        validate_certs: "{{ infoblox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
        timeout: 60
        follow_redirects: none
        use_proxy: no
      register: ib_networks

    - name: Get Infoblox fixed addresses (ipv4addr,name) (no redirects)
      ansible.builtin.uri:
        url: "{{ ib_base }}/fixedaddress?_return_fields=ipv4addr,name&_max_results={{ ib_safe_max_results }}"
        headers: { Accept: "application/json" }
        url_username: "{{ infoblox_username }}"
        url_password: "{{ infoblox_password }}"
        force_basic_auth: true
        validate_certs: "{{ infoblox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
        timeout: 60
        follow_redirects: none
        use_proxy: no
      register: ib_fixed

    - name: Get Infoblox VLANs (id,name,parent,description) (no redirects)
      ansible.builtin.uri:
        url: "{{ ib_base }}/vlan?_return_fields=id,name,parent,description&_max_results={{ ib_safe_max_results }}"
        headers: { Accept: "application/json" }
        url_username: "{{ infoblox_username }}"
        url_password: "{{ infoblox_password }}"
        force_basic_auth: true
        validate_certs: "{{ infoblox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
        timeout: 60
        follow_redirects: none
        use_proxy: no
      register: ib_vlans

    ###########################################################################
    # NetBox reads
    ###########################################################################
    - name: Get NetBox prefixes (all)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/prefixes/?limit=0"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
        timeout: 60
        follow_redirects: all
        use_proxy: no
      register: nb_prefixes

    - name: Get NetBox IP addresses (all)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/ip-addresses/?limit=0"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
        timeout: 60
        follow_redirects: all
        use_proxy: no
      register: nb_ips

    - name: Get NetBox VLANs (all)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/vlans/?limit=0"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
        timeout: 60
        follow_redirects: all
        use_proxy: no
      register: nb_vlans

    ###########################################################################
    # Build Infoblox lists & maps
    ###########################################################################
    - name: Build Infoblox network & IP lists
      ansible.builtin.set_fact:
        ib_network_list: "{{ ib_networks.json | map(attribute='network') | list | default([]) }}"
        ib_ip_list: "{{ ib_fixed.json | map(attribute='ipv4addr') | list | default([]) }}"

    - name: Initialize VLAN list
      ansible.builtin.set_fact:
        ib_vlan_list: []

    - name: Append VLAN items (vid/name/parent/description)
      ansible.builtin.set_fact:
        ib_vlan_list: >-
          {{ ib_vlan_list + [ {
              'vid': item.id | int,
              'name': item.name | default(''),
              'parent': item.parent | default(''),
              'description': item.description | default('')
            } ] }}
      loop: "{{ ib_vlans.json | default([]) }}"

    # Build network → VLAN-IDs map (extract VLAN vid from Infoblox refs)
    - name: Initialize Infoblox network→VLAN map
      ansible.builtin.set_fact:
        ib_net_vlan_map: {}

    - name: Collect VLAN IDs for each Infoblox network
      ansible.builtin.set_fact:
        vids_for_net: >-
          {{
            item.vlans | default([]) |
            map(attribute='vlan') |
            map('regex_replace', '^.*/', '') |
            map('int') | list
          }}
      loop: "{{ ib_networks.json | default([]) }}"
      loop_control:
        label: "{{ item.network }}"
      register: ib_net_vlan_vids

    - name: Merge per-network VLAN IDs into ib_net_vlan_map
      ansible.builtin.set_fact:
        ib_net_vlan_map: "{{ ib_net_vlan_map combine({ item.item.network: (item.vids_for_net | default([])) }) }}"
      loop: "{{ ib_net_vlan_vids.results | default([]) }}"
      when: item.item.network is defined

    # Build list of (network, first_vlan_vid) pairs for patching
    - name: Initialize pairs list for prefix→vlan patch
      ansible.builtin.set_fact:
        ib_net_vlan_pairs: []

    - name: Collect (network, first_vlan_vid) pairs
      ansible.builtin.set_fact:
        ib_net_vlan_pairs: "{{ ib_net_vlan_pairs + [ {'network': item.key, 'vid': (item.value | first)} ] }}"
      loop: "{{ ib_net_vlan_map | dict2items }}"
      when: (item.value | length) > 0

    - name: Warn when multiple VLANs are assigned to a single network
      ansible.builtin.debug:
        msg: "Network {{ item.key }} has multiple VLANs assigned in Infoblox: {{ item.value }}"
      loop: "{{ ib_net_vlan_map | dict2items }}"
      when: (item.value | length) > 1

    ###########################################################################
    # Build NetBox lists + drift (prefixes, IPs, VLANs)
    ###########################################################################
    - name: Build NetBox lists
      ansible.builtin.set_fact:
        nb_prefix_list: "{{ (nb_prefixes.json.results | map(attribute='prefix') | list) | default([]) }}"
        nb_ip_list: "{{ (nb_ips.json.results | map(attribute='address') | map('regex_replace','/\\d+$','') | list) | default([]) }}"
        nb_vlan_vid_list: "{{ nb_vlans.json.results | map(attribute='vid') | list | default([]) }}"
        ib_vlan_vid_list: "{{ ib_vlans.json | map(attribute='id') | list | default([]) }}"

    - name: Compute drift (prefixes, IPs, VLANs)
      ansible.builtin.set_fact:
        drift_networks_missing_in_nb: "{{ ib_network_list | difference(nb_prefix_list) }}"
        drift_networks_extra_in_nb:   "{{ nb_prefix_list | difference(ib_network_list) }}"
        drift_ips_missing_in_nb:      "{{ ib_ip_list | difference(nb_ip_list) }}"
        drift_ips_extra_in_nb:        "{{ nb_ip_list | difference(ib_ip_list) }}"
        drift_vlans_missing_in_nb:    "{{ ib_vlan_vid_list | difference(nb_vlan_vid_list) }}"
        drift_vlans_extra_in_nb:      "{{ nb_vlan_vid_list | difference(ib_vlan_vid_list) }}"

    ###########################################################################
    # CREATE: prefixes, IPs, VLANs (check-then-create; add description; require 201)
    ###########################################################################
    - name: Check if prefix exists (NetBox)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/prefixes/?prefix={{ item }}"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
      loop: "{{ drift_networks_missing_in_nb }}"
      register: nb_prefix_checks

    - name: Create missing prefixes (with description)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/prefixes/"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: POST
        body_format: json
        body:
          prefix: "{{ item }}"
          status: "active"
          description: "Imported from Infoblox"
        status_code: [201]
        return_content: true
      loop: "{{ drift_networks_missing_in_nb }}"
      when: >
        (remediate_prefixes | default(true)) and
        ((nb_prefix_checks.results
          | selectattr('item','equalto', item)
          | map(attribute='json')
          | map(attribute='count')
          | list
          | first
          | int) == 0)
      register: nb_prefix_creates

    - name: Check if IP exists (NetBox)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/ip-addresses/?address={{ item }}/32"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
      loop: "{{ drift_ips_missing_in_nb }}"
      register: nb_ip_checks

    - name: Create missing IPs (with description)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/ip-addresses/"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: POST
        body_format: json
        body:
          address: "{{ item }}/32"
          status: "active"
          description: "Imported from Infoblox"
        status_code: [201]
        return_content: true
      loop: "{{ drift_ips_missing_in_nb }}"
      when: >
        (remediate_ips | default(true)) and
        ((nb_ip_checks.results
          | selectattr('item','equalto', item)
          | map(attribute='json')
          | map(attribute='count')
          | list
          | first
          | int) == 0)
      register: nb_ip_creates

    - name: Check if VLAN exists in NetBox by vid (optionally site)
      ansible.builtin.uri:
        url: >-
          {{ netbox_url }}/api/ipam/vlans/?vid={{ item.vid }}
          {% if netbox_vlan_site is defined and netbox_vlan_site|length > 0 %}
          &site={{ netbox_vlan_site | urlencode }}
          {% endif %}
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
      loop: "{{ ib_vlan_list }}"
      register: nb_vlan_checks

    - name: Create missing VLANs (with description)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/vlans/"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: POST
        body_format: json
        body:
          vid: "{{ item.vid | int }}"
          name: "{{ item.name | default('VLAN' ~ item.vid) }}"
          status: "active"
          description: "Imported from Infoblox"
        status_code: [201]
        return_content: true
      loop: "{{ ib_vlan_list }}"
      when: >
        (remediate_vlans | default(true)) and
        ((nb_vlan_checks.results
          | selectattr('item.vid','equalto', item.vid)
          | map(attribute='json')
          | map(attribute='count')
          | list
          | first
          | int) == 0)
      register: nb_vlan_creates

    ###########################################################################
    # PATCH: link NetBox prefix.vlan using Infoblox network→VLAN map (strict with VLAN id)
    ###########################################################################
    - name: Associate NetBox prefixes to VLANs (strict per-item)
      vars:
        infoblox_pairs: "{{ ib_net_vlan_pairs }}"
      loop: "{{ infoblox_pairs }}"
      loop_control:
        label: "prefix={{ item.network }} → vid={{ item.vid }}"
      when: patch_prefix_vlan | default(true)
      block:

        - name: Lookup NetBox VLAN by vid (optionally constrain by site)
          ansible.builtin.uri:
            url: >-
              {{ netbox_url }}/api/ipam/vlans/?vid={{ item.vid }}
              {% if netbox_vlan_site is defined and netbox_vlan_site|length > 0 %}
              &site={{ netbox_vlan_site | urlencode }}
              {% endif %}
            headers: "{{ nb_headers }}"
            validate_certs: "{{ netbox_verify_ssl }}"
            method: GET
            return_content: true
            status_code: [200]
            timeout: 30
          register: vlan_q

        - name: Fail if VLAN lookup is ambiguous or missing
          ansible.builtin.assert:
            that:
              - vlan_q.json.count | int == 1
            fail_msg: >-
              VLAN lookup for vid={{ item.vid }} returned {{ vlan_q.json.count | int }} result(s).
              {% if vlan_q.json.count | int > 1 %}
              Multiple VLANs share the same vid. Constrain by site using `netbox_vlan_site` or ensure unique vids.
              {% else %}
              No VLAN found; create it first or verify vid mapping from Infoblox.
              {% endif %}

        - name: Lookup NetBox Prefix by CIDR
          ansible.builtin.uri:
            url: "{{ netbox_url }}/api/ipam/prefixes/?prefix={{ item.network }}"
            headers: "{{ nb_headers }}"
            validate_certs: "{{ netbox_verify_ssl }}"
            method: GET
            return_content: true
            status_code: [200]
            timeout: 30
          register: prefix_q

        - name: Fail if prefix lookup is ambiguous or missing
          ansible.builtin.assert:
            that:
              - prefix_q.json.count | int == 1
            fail_msg: >-
              Prefix lookup for {{ item.network }} returned {{ prefix_q.json.count | int }} result(s).
              Ensure the prefix exists and is unique.

        - name: PATCH prefix → set VLAN (use VLAN primary key id) and description
          ansible.builtin.uri:
            url: "{{ netbox_url }}/api/ipam/prefixes/{{ prefix_q.json.results[0].id }}/"
            headers: "{{ nb_headers }}"
            validate_certs: "{{ netbox_verify_ssl }}"
            method: PATCH
            body_format: json
            body:
              vlan: "{{ vlan_q.json.results[0].id }}"  # NetBox expects VLAN PK, not vid
              description: "Imported from Infoblox"
            status_code: [200]
            return_content: true
            timeout: 30
          register: patch_q

        - name: Show per-item patch result
          ansible.builtin.debug:
            msg: >-
              Patched prefix {{ item.network }} with VLAN id={{ vlan_q.json.results[0].id }} (vid={{ item.vid }}).
              New description="{{ patch_q.json.description | default('') }}".
              API status={{ patch_q.status }}.

    - name: Show PREFIX→VLAN patch summary
      ansible.builtin.debug:
        msg:
          - "Pairs considered: {{ ib_net_vlan_pairs | length }}"
          - "Hint: If any item failed earlier, check the assert error for the exact reason."

    ###########################################################################
    # OPTIONAL: Patch description on existing VLANs/prefixes (if empty)
    ###########################################################################
    - name: Patch description on VLANs missing description (optional)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/vlans/{{ item.id }}/"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: PATCH
        body_format: json
        body:
          description: "Imported from Infoblox"
        status_code: [200]
      loop: "{{ nb_vlans.json.results | default([]) }}"
      when: (item.description | default('')) | length == 0

    - name: Patch description on prefixes missing description (optional)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/prefixes/{{ item.id }}/"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: PATCH
        body_format: json
        body:
          description: "Imported from Infoblox"
        status_code: [200]
      loop: "{{ nb_prefixes.json.results | default([]) }}"
      when: (item.description | default('')) | length == 0

    ###########################################################################
    # DELETE: prefixes, VLANs (toggleable; require 204)
    ###########################################################################
    - name: Resolve NetBox prefix IDs for deletion
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/prefixes/?prefix={{ item }}"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
      loop: "{{ drift_networks_extra_in_nb }}"
      when: delete_prefixes_missing_in_infoblox | default(false)
      register: nb_prefix_delete_lookup

    - name: Delete extra prefixes (require 204)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/prefixes/{{ prefix_id }}/"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: DELETE
        status_code: [204]
      vars:
        prefix_id: "{{ (item.json.results | map(attribute='id') | list | first) | default('') }}"
      loop: "{{ nb_prefix_delete_lookup.results | default([]) }}"
      when:
        - delete_prefixes_missing_in_infoblox | default(false)
        - prefix_id | length > 0
      register: nb_prefix_deletes
      failed_when: nb_prefix_deletes.status != 204

    - name: Resolve NetBox VLAN IDs for deletion (by vid)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/vlans/?vid={{ item }}"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
      loop: "{{ drift_vlans_extra_in_nb }}"
      when: delete_vlans_missing_in_infoblox | default(false)
      register: nb_vlan_delete_lookup

    - name: Delete extra VLANs (require 204)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/vlans/{{ vlan_id }}/"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: DELETE
        status_code: [204]
      vars:
        vlan_id: "{{ (item.json.results | map(attribute='id') | list | first) | default('') }}"
      loop: "{{ nb_vlan_delete_lookup.results | default([]) }}"
      when:
        - delete_vlans_missing_in_infoblox | default(false)
        - vlan_id | length > 0
      register: nb_vlan_deletes
      failed_when: nb_vlan_deletes.status != 204
``


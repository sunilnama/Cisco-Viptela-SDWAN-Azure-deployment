---
- name: Sync Infoblox → NetBox (create, delete, and map Prefix ↔ VLAN) + diagnostics (string refs supported)
  hosts: localhost
  gather_facts: false
  connection: local

  vars:
    ib_host: "{{ infoblox_host | regex_replace('/+$', '') }}"
    ib_wapi_ver: "{{ (infoblox_wapi_version | default('2.11')) | regex_replace('^v', '') }}"
    ib_base: "{{ ib_host }}/wapi/v{{ ib_wapi_ver }}"

    nb_headers:
      Authorization: "Token {{ netbox_token }}"
      Content-Type: "application/json"

    ib_safe_max_results: 500

    remediate_prefixes: true
    remediate_ips: true
    remediate_vlans: true
    patch_prefix_vlan: true

    delete_prefixes_missing_in_infoblox: true
    delete_vlans_missing_in_infoblox: false

    netbox_vlan_site: ""
    netbox_prefix_vrf_slug: ""
    min_netbox_version: "3.5"
    run_debug: true

  tasks:
    # ---- NetBox probe ----
    - name: Probe NetBox API root
      uri:
        url: "{{ netbox_url }}/api/"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
      register: nb_root

    - name: Assert NetBox API reachable
      assert:
        that:
          - nb_root.status == 200

    # ---- Infoblox pulls ----
    - name: Get Infoblox networks (CIDRs)
      uri:
        url: "{{ ib_base }}/network?_return_fields=network&_max_results={{ ib_safe_max_results }}"
        headers: { Accept: "application/json" }
        url_username: "{{ infoblox_username }}"
        url_password: "{{ infoblox_password }}"
        force_basic_auth: true
        validate_certs: "{{ infoblox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
      register: ib_networks

    - name: Get Infoblox VLANs (with assigned_to)
      uri:
        url: "{{ ib_base }}/vlan?_return_fields=id,name,parent,description,assigned_to&_max_results={{ ib_safe_max_results }}"
        headers: { Accept: "application/json" }
        url_username: "{{ infoblox_username }}"
        url_password: "{{ infoblox_password }}"
        force_basic_auth: true
        validate_certs: "{{ infoblox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
      register: ib_vlans

    # ---- Build mapping from VLAN.assigned_to ----
    - name: Initialize IB maps/lists
      set_fact:
        ib_net_vlan_map: "{{ ib_net_vlan_map | default({}) }}"
        ib_vlan_net_refs: []

    - name: DEBUG | First 5 VLANs with assignments (raw)
      debug:
        msg: "{{ (ib_vlans.json | default([]) | selectattr('assigned_to','defined') | selectattr('assigned_to','ne', []) | list) | json_query('[0:5]') }}"
      when: run_debug | default(true)

    - name: Collect {ref, vid} from VLAN.assigned_to (supports string refs)
      set_fact:
        ib_vlan_net_refs: "{{ (ib_vlan_net_refs | default([])) + [ {
          'ref': ref_to_use,
          'vid': (item.0.id | int),
          'vlan_name': (item.0.name | default(''))
        } ] }}"
      vars:
        # assigned_to items may be plain strings like "network/..." OR dicts
        ref_to_use: >-
          {{ item.1 if (item.1 is string)
             else (item.1.network | default(item.1.ipv6network | default(''))) }}
      loop: "{{ ib_vlans.json | default([]) | subelements('assigned_to', skip_missing=True) }}"
      when: ref_to_use | length > 0

    - name: DEBUG | ib_vlan_net_refs (first few entries)
      debug:
        msg: "{{ ib_vlan_net_refs | list | json_query('[0:10]') }}"
      when: run_debug | default(true)

    - name: Fetch CIDR for each assigned ref
      uri:
        url: "{{ ib_base }}/{{ item.ref }}?_return_fields=network"
        headers: { Accept: "application/json" }
        url_username: "{{ infoblox_username }}"
        url_password: "{{ infoblox_password }}"
        force_basic_auth: true
        validate_certs: "{{ infoblox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
      loop: "{{ ib_vlan_net_refs | default([]) }}"
      register: ib_vlan_assigned_cidrs

    - name: Merge CIDRs into ib_net_vlan_map (CIDR → vid)
      set_fact:
        ib_net_vlan_map: "{{ (ib_net_vlan_map | default({})) | combine({ (item.json.network): (ib_vlan_net_refs[loop.index0].vid) }) }}"
      loop: "{{ ib_vlan_assigned_cidrs.results | default([]) }}"
      when:
        - item.json is defined
        - item.json.network is defined

    - name: DEBUG | ib_net_vlan_map sample
      debug:
        msg: "{{ (ib_net_vlan_map | default({})) | dict2items | list | json_query('[0:10]') }}"
      when: run_debug | default(true)

    - name: Build pairs list for prefix→vlan patch
      set_fact:
        ib_net_vlan_pairs: []

    - name: Collect (network, vlan_vid) pairs
      set_fact:
        ib_net_vlan_pairs: "{{ ib_net_vlan_pairs + [ {'network': item.key, 'vid': item.value} ] }}"
      loop: "{{ (ib_net_vlan_map | default({})) | dict2items }}"
      when: (ib_net_vlan_map | default({})) | length > 0

    - name: DEBUG | first 10 pairs
      debug:
        msg: "{{ ib_net_vlan_pairs | list | json_query('[0:10]') }}"
      when: run_debug | default(true)

    # ---- PATCH logic (unchanged) ----
    - name: Lookup NetBox VLAN by vid (optional site)
      uri:
        url: >-
          {{ netbox_url }}/api/ipam/vlans/?vid={{ item.vid }}
          {% if netbox_vlan_site | length > 0 %}&site={{ netbox_vlan_site | urlencode }}{% endif %}
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
      loop: "{{ ib_net_vlan_pairs | default([]) }}"
      register: nb_vlan_lookup_pairs

    - name: Lookup NetBox Prefix by CIDR (optional VRF filter)
      uri:
        url: >-
          {{ netbox_url }}/api/ipam/prefixes/?prefix={{ item.network }}
          {% if netbox_prefix_vrf_slug | length > 0 %}&vrf={{ netbox_prefix_vrf_slug | urlencode }}{% endif %}
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
      loop: "{{ ib_net_vlan_pairs | default([]) }}"
      register: nb_prefix_lookup_pairs

    - name: Assert VLAN lookup unique
      assert:
        that:
          - item.json.count | int == 1
        fail_msg: "VLAN GET for vid={{ item.item.vid }} returned {{ item.json.count | int }} results."
      loop: "{{ nb_vlan_lookup_pairs.results | default([]) }}"

    - name: Assert Prefix lookup unique
      assert:
        that:
          - item.json.count | int == 1
        fail_msg: "Prefix GET for {{ item.item.network }} returned {{ item.json.count | int }} results."
      loop: "{{ nb_prefix_lookup_pairs.results | default([]) }}"

    - name: PATCH prefix → set VLAN (use VLAN PK id) and description
      uri:
        url: "{{ netbox_url }}/api/ipam/prefixes/{{ nb_prefix_id }}"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: PATCH
        body_format: json
        body:
          vlan: "{{ nb_vlan_pk | int }}"
          description: "Imported from Infoblox"
        status_code: [200]
      vars:
        nb_vlan_pk: >-
          {{ (
              nb_vlan_lookup_pairs.results
              | selectattr('item.vid','equalto', item.vid)
              | map(attribute='json')
              | map(attribute='results')
              | list
              | first
              | default([])
            ) | map(attribute='id') | first | default(0) }}
        nb_prefix_id: >-
          {{ (
              nb_prefix_lookup_pairs.results
              | selectattr('item.network','equalto', item.network)
              | map(attribute='json')
              | map(attribute='results')
              | list
              | first
              | default([])
            ) | map(attribute='id') | first | default('') }}
      loop: "{{ ib_net_vlan_pairs | default([]) }}"
      when:
        - nb_vlan_pk | int > 0
        - nb_prefix_id | length > 0
      register: nb_prefix_vlan_patches

    - name: PATCH summary
      debug:
        msg:
          - "Pairs considered: {{ ib_net_vlan_pairs | length }}"
          - "Patched: {{ (nb_prefix_vlan_patches.results | selectattr('status','equalto',200) | list | length) if nb_prefix_vlan_patches is defined else 0 }}"
          - "Failures: {{ (nb_prefix_vlan_patches.results | rejectattr('status','equalto',200) | list | length) if nb_prefix_vlan_patches is defined else 0 }}"

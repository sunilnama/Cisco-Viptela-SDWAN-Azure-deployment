# -------- Read from Infoblox WAPI (no collections) --------
- name: Get Infoblox networks (CIDRs)
  ansible.builtin.uri:
    url: "{{ infoblox_host }}/wapi/v{{ infoblox_wapi_version }}/network?_return_fields=network&_max_results=1000"
    headers:
      Accept: "application/json"
    user: "{{ infoblox_username }}"
    password: "{{ infoblox_password }}"
    force_basic_auth: true
    validate_certs: "{{ infoblox_verify_ssl }}"
    method: GET
    return_content: true
    timeout: 60
    follow_redirects: all
    use_proxy: no
  register: ib_networks

- name: Get Infoblox fixed addresses (static IPs)
  ansible.builtin.uri:
    url: "{{ infoblox_host }}/wapi/v{{ infoblox_wapi_version }}/fixedaddress?_return_fields=ip_address,name&_max_results=1000"
    headers:
      Accept: "application/json"
    user: "{{ infoblox_username }}"
    password: "{{ infoblox_password }}"
    force_basic_auth: true
    validate_certs: "{{ infoblox_verify_ssl }}"
    method: GET
    return_content: true
    timeout: 60
    follow_redirects: all
    use_proxy: no
  register: ib_fixed





# Example: use paging for networks
- name: Get Infoblox networks with paging enabled (first page)
  ansible.builtin.uri:
    url: "{{ infoblox_host }}/wapi/v{{ infoblox_wapi_version }}/network?_return_fields=network&_paging=1&_max_results=1000"
    headers:
      Accept: "application/json"
    user: "{{ infoblox_username }}"
    password: "{{ infoblox_password }}"
    force_basic_auth: true
    validate_certs: "{{ infoblox_verify_ssl }}"
    method: GET
    return_content: true
  register: ib_net_page1

# ib_net_page1.json will include "next_page_id" when there are more results.
# You can loop with subsequent GETs: ...?_paging=1&_page_id={{ ib_net_page1.json.next_page_id }}





---
- name: Sync Infoblox → NetBox (create, delete, and map Prefix ↔ VLAN)
  hosts: localhost
  gather_facts: false
  connection: local

  vars:
    # ---------- Infoblox ----------
    ib_host: "{{ infoblox_host | regex_replace('/+$', '') }}"
    ib_wapi_ver: "{{ (infoblox_wapi_version | default('2.11')) | regex_replace('^v', '') }}"
    ib_base: "{{ ib_host }}/wapi/v{{ ib_wapi_ver }}"

    # ---------- NetBox ----------
    nb_headers:
      Authorization: "Token {{ netbox_token }}"
      Content-Type: "application/json"

    # ---------- Tunables ----------
    ib_safe_max_results: 500

    remediate_prefixes: true            # create missing prefixes
    remediate_ips: true                 # create missing IPs
    remediate_vlans: true               # create missing VLANs
    patch_prefix_vlan: true             # set prefix.vlan using VLAN PK id

    delete_prefixes_missing_in_infoblox: true
    delete_vlans_missing_in_infoblox: false

    # Optional: constrain VLAN lookup by site if vids repeat across sites
    netbox_vlan_site: ""

    # Optional NetBox version guard (used only if API-Version header is exposed)
    min_netbox_version: "3.5"

  tasks:
    ###########################################################################
    # NetBox readiness + (optional) version check
    ###########################################################################
    - name: Probe NetBox API root
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
        timeout: 60
        follow_redirects: all
        use_proxy: no
      register: nb_root

    - name: Assert NetBox API reachable
      ansible.builtin.assert:
        that:
          - nb_root.status == 200
        fail_msg: "NetBox API root not reachable at {{ netbox_url }}/api/"

    - name: Extract NetBox API version header (if any)
      ansible.builtin.set_fact:
        nb_api_version_raw: "{{ (nb_root.headers | default({}))['API-Version'] | default((nb_root.headers | default({}))['api-version'] | default('')) }}"

    - name: Normalize NetBox API-Version to semver X.Y.Z
      ansible.builtin.set_fact:
        nb_api_version_semver: "{{ nb_api_version_raw ~ ('.0' if (nb_api_version_raw.split('.') | length == 2) else '') }}"
      when: nb_api_version_raw | length > 0

    - name: Normalize minimum NetBox version to semver X.Y.Z
      ansible.builtin.set_fact:
        min_nb_semver: "{{ min_netbox_version ~ ('.0' if (min_netbox_version.split('.') | length == 2) else '') }}"

    - name: Enforce minimum NetBox version (only when header present)
      ansible.builtin.assert:
        that:
          - nb_api_version_semver is version(min_nb_semver, '>=')
        fail_msg: "NetBox version too old: got {{ nb_api_version_semver }}, need >= {{ min_nb_semver }}."
      when: nb_api_version_raw | length > 0

    ###########################################################################
    # Infoblox pulls (networks, fixedaddress, VLANs with assigned_to)
    ###########################################################################
    - name: Get Infoblox networks (CIDRs)
      ansible.builtin.uri:
        url: "{{ ib_base }}/network?_return_fields=network&_max_results={{ ib_safe_max_results }}"
        headers: { Accept: "application/json" }
        url_username: "{{ infoblox_username }}"
        url_password: "{{ infoblox_password }}"
        force_basic_auth: true
        validate_certs: "{{ infoblox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
        timeout: 60
        follow_redirects: none
        use_proxy: no
      register: ib_networks

    - name: Get Infoblox fixed addresses (IPv4)
      ansible.builtin.uri:
        url: "{{ ib_base }}/fixedaddress?_return_fields=ipv4addr,name&_max_results={{ ib_safe_max_results }}"
        headers: { Accept: "application/json" }
        url_username: "{{ infoblox_username }}"
        url_password: "{{ infoblox_password }}"
        force_basic_auth: true
        validate_certs: "{{ infoblox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
        timeout: 60
        follow_redirects: none
        use_proxy: no
      register: ib_fixed

    - name: Get Infoblox VLANs (include assigned_to)
      ansible.builtin.uri:
        url: "{{ ib_base }}/vlan?_return_fields=id,name,parent,description,assigned_to&_max_results={{ ib_safe_max_results }}"
        headers: { Accept: "application/json" }
        url_username: "{{ infoblox_username }}"
        url_password: "{{ infoblox_password }}"
        force_basic_auth: true
        validate_certs: "{{ infoblox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
        timeout: 60
        follow_redirects: none
        use_proxy: no
      register: ib_vlans

    ###########################################################################
    # Build lists (Infoblox + NetBox drift)
    ###########################################################################
    - name: Build Infoblox network & IP lists
      ansible.builtin.set_fact:
        ib_network_list: "{{ ib_networks.json | map(attribute='network') | list | default([]) }}"
        ib_ip_list: "{{ ib_fixed.json | map(attribute='ipv4addr') | list | default([]) }}"

    - name: Get NetBox prefixes (all)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/prefixes/?limit=0"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
      register: nb_prefixes

    - name: Get NetBox IP addresses (all)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/ip-addresses/?limit=0"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
      register: nb_ips

    - name: Get NetBox VLANs (all)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/vlans/?limit=0"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
      register: nb_vlans

    - name: Build NetBox lists (values)
      ansible.builtin.set_fact:
        nb_prefix_list: "{{ (nb_prefixes.json.results | map(attribute='prefix') | list) | default([]) }}"
        nb_ip_list: "{{ (nb_ips.json.results | map(attribute='address') | map('regex_replace','/\\d+$','') | list) | default([]) }}"
        nb_vlan_vid_list: "{{ nb_vlans.json.results | map(attribute='vid') | list | default([]) }}"
        ib_vlan_vid_list: "{{ ib_vlans.json | map(attribute='id') | list | default([]) }}"

    - name: Compute drift
      ansible.builtin.set_fact:
        drift_networks_missing_in_nb: "{{ ib_network_list | difference(nb_prefix_list) }}"
        drift_networks_extra_in_nb:   "{{ nb_prefix_list | difference(ib_network_list) }}"
        drift_ips_missing_in_nb:      "{{ ib_ip_list | difference(nb_ip_list) }}"
        drift_ips_extra_in_nb:        "{{ nb_ip_list | difference(ib_ip_list) }}"
        drift_vlans_missing_in_nb:    "{{ ib_vlan_vid_list | difference(nb_vlan_vid_list) }}"
        drift_vlans_extra_in_nb:      "{{ nb_vlan_vid_list | difference(ib_vlan_vid_list) }}"

    ###########################################################################
    # CREATE: prefixes, IPs, VLANs (idempotent)
    ###########################################################################
    - name: Check if prefix exists
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/prefixes/?prefix={{ item }}"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
      loop: "{{ drift_networks_missing_in_nb }}"
      register: nb_prefix_checks

    - name: Create missing prefixes (with description)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/prefixes/"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: POST
        body_format: json
        body:
          prefix: "{{ item }}"
          status: "active"
          description: "Imported from Infoblox"
        status_code: [201]
        return_content: true
      loop: "{{ drift_networks_missing_in_nb }}"
      when: >
        (remediate_prefixes | default(true)) and
        ((nb_prefix_checks.results | selectattr('item','equalto', item) | map(attribute='json') | map(attribute='count') | list | first | int) == 0)
      register: nb_prefix_creates

    - name: Check if IP exists
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/ip-addresses/?address={{ item }}/32"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
      loop: "{{ drift_ips_missing_in_nb }}"
      register: nb_ip_checks

    - name: Create missing IPs (with description)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/ip-addresses/"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: POST
        body_format: json
        body:
          address: "{{ item }}/32"
          status: "active"
          description: "Imported from Infoblox"
        status_code: [201]
        return_content: true
      loop: "{{ drift_ips_missing_in_nb }}"
      when: >
        (remediate_ips | default(true)) and
        ((nb_ip_checks.results | selectattr('item','equalto', item) | map(attribute='json') | map(attribute='count') | list | first | int) == 0)
      register: nb_ip_creates

    - name: Check if VLAN exists in NetBox by vid (optional site)
      ansible.builtin.uri:
        url: >-
          {{ netbox_url }}/api/ipam/vlans/?vid={{ item.id | int }}
          {% if netbox_vlan_site is defined and netbox_vlan_site|length > 0 %}
          &site={{ netbox_vlan_site | urlencode }}
          {% endif %}
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
      loop: "{{ ib_vlans.json | default([]) }}"
      register: nb_vlan_checks

    - name: Create missing VLANs (with description)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/vlans/"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: POST
        body_format: json
        body:
          vid: "{{ item.id | int }}"
          name: "{{ item.name | default('VLAN' ~ item.id) }}"
          status: "active"
          description: "Imported from Infoblox"
        status_code: [201]
        return_content: true
      loop: "{{ ib_vlans.json | default([]) }}"
      when: >
        (remediate_vlans | default(true)) and
        ((nb_vlan_checks.results | selectattr('item.id','equalto', item.id) | map(attribute='json') | map(attribute='count') | list | first | int) == 0)
      register: nb_vlan_creates

    ###########################################################################
    # BUILD mapping from Infoblox VLAN.assigned_to (robust, no block+loop)
    ###########################################################################
    - name: Ensure ib_net_vlan_map is a dict
      ansible.builtin.set_fact:
        ib_net_vlan_map: "{{ ib_net_vlan_map | default({}) }}"

    - name: Initialize list of VLAN→network refs
      ansible.builtin.set_fact:
        ib_vlan_net_refs: []

    - name: Collect {ref, vid} from VLAN.assigned_to
      ansible.builtin.set_fact:
        ib_vlan_net_refs: "{{ (ib_vlan_net_refs | default([])) + [ {'ref': ref_to_use, 'vid': (item.0.id | int)} ] }}"
      vars:
        ref_to_use: "{{ item.1.network | default(item.1.ipv6network | default('')) }}"
      loop: "{{ ib_vlans.json | default([]) | subelements('assigned_to', skip_missing=True) }}"
      when: ref_to_use | length > 0

    - name: Fetch CIDR for each assigned ref
      ansible.builtin.uri:
        url: "{{ ib_base }}/{{ item.ref }}?_return_fields=network"
        headers: { Accept: "application/json" }
        url_username: "{{ infoblox_username }}"
        url_password: "{{ infoblox_password }}"
        force_basic_auth: true
        validate_certs: "{{ infoblox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
        timeout: 30
        follow_redirects: none
        use_proxy: no
      loop: "{{ ib_vlan_net_refs | default([]) }}"
      register: ib_vlan_assigned_cidrs

    - name: Merge CIDRs into ib_net_vlan_map (CIDR → vid)
      ansible.builtin.set_fact:
        ib_net_vlan_map: "{{ (ib_net_vlan_map | default({})) | combine( { (item.json.network): ( ib_vlan_net_refs[(loop.index0)].vid ) } ) }}"
      loop: "{{ ib_vlan_assigned_cidrs.results | default([]) }}"
      when:
        - item.json is defined
        - item.json.network is defined

    - name: Initialize pairs list for prefix→vlan patch
      ansible.builtin.set_fact:
        ib_net_vlan_pairs: []

    - name: Collect (network, vlan_vid) pairs (safe)
      ansible.builtin.set_fact:
        ib_net_vlan_pairs: "{{ ib_net_vlan_pairs + [ {'network': item.key, 'vid': item.value} ] }}"
      loop: "{{ (ib_net_vlan_map | default({})) | dict2items }}"
      when: (ib_net_vlan_map | default({})) | length > 0

    ###########################################################################
    # PATCH: set NetBox prefix.vlan (use VLAN PK id)
    ###########################################################################
    - name: Lookup NetBox VLAN by vid (optional site)
      ansible.builtin.uri:
        url: >-
          {{ netbox_url }}/api/ipam/vlans/?vid={{ item.vid }}
          {% if netbox_vlan_site is defined and netbox_vlan_site|length > 0 %}
          &site={{ netbox_vlan_site | urlencode }}
          {% endif %}
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
        timeout: 30
      loop: "{{ ib_net_vlan_pairs | default([]) }}"
      register: nb_vlan_lookup_pairs

    - name: Lookup NetBox Prefix by CIDR
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/prefixes/?prefix={{ item.network }}"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
        timeout: 30
      loop: "{{ ib_net_vlan_pairs | default([]) }}"
      register: nb_prefix_lookup_pairs

    - name: Assert VLAN lookup unique
      ansible.builtin.assert:
        that:
          - item.json.count | int == 1
        fail_msg: >-
          VLAN GET for vid={{ item.item.vid }} returned {{ item.json.count | int }} results.
          Constrain by site (netbox_vlan_site) or verify VLAN presence.
      loop: "{{ nb_vlan_lookup_pairs.results | default([]) }}"

    - name: Assert Prefix lookup unique
      ansible.builtin.assert:
        that:
          - item.json.count | int == 1
        fail_msg: >-
          Prefix GET for {{ item.item.network }} returned {{ item.json.count | int }} results.
          Ensure the prefix exists and is unique.
      loop: "{{ nb_prefix_lookup_pairs.results | default([]) }}"

    - name: PATCH prefix → set VLAN (use VLAN PK id) and description
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/prefixes/{{ nb_prefix_id }}"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: PATCH
        body_format: json
        body:
          vlan: "{{ nb_vlan_pk | int }}"   # NetBox expects VLAN PK id
          description: "Imported from Infoblox"
        status_code: [200]
        return_content: true
        timeout: 30
      vars:
        nb_vlan_pk: >-
          {{ (
              nb_vlan_lookup_pairs.results
              | selectattr('item.vid','equalto', item.vid)
              | map(attribute='json')
              | map(attribute='results')
              | list
              | first
              | default([])
            ) | map(attribute='id') | first | default(0) }}
        nb_prefix_id: >-
          {{ (
              nb_prefix_lookup_pairs.results
              | selectattr('item.network','equalto', item.network)
              | map(attribute='json')
              | map(attribute='results')
              | list
              | first
              | default([])
            ) | map(attribute='id') | first | default('') }}
      loop: "{{ ib_net_vlan_pairs | default([]) }}"
      when:
        - nb_vlan_pk | int > 0
        - nb_prefix_id | length > 0
      register: nb_prefix_vlan_patches

    - name: PATCH summary
      ansible.builtin.debug:
        msg:
          - "Pairs considered: {{ ib_net_vlan_pairs | length }}"
          - "Patched: {{ (nb_prefix_vlan_patches.results | selectattr('status','equalto',200) | list | length) if nb_prefix_vlan_patches is defined else 0 }}"
          - "Failures: {{ (nb_prefix_vlan_patches.results | rejectattr('status','equalto',200) | list | length) if nb_prefix_vlan_patches is defined else 0 }}"

    ###########################################################################
    # OPTIONAL: backfill descriptions
    ###########################################################################
    - name: Patch VLAN descriptions if missing
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/vlans/{{ item.id }}"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: PATCH
        body_format: json
        body:
          description: "Imported from Infoblox"
        status_code: [200]
      loop: "{{ nb_vlans.json.results | default([]) }}"
      when: (item.description | default('')) | length == 0

    - name: Patch prefix descriptions if missing
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/prefixes/{{ item.id }}"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: PATCH
        body_format: json
        body:
          description: "Imported from Infoblox"
        status_code: [200]
      loop: "{{ nb_prefixes.json.results | default([]) }}"
      when: (item.description | default('')) | length == 0

    ###########################################################################
    # DELETE (optional toggles)
    ###########################################################################
    - name: Resolve NetBox prefix IDs for deletion
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/prefixes/?prefix={{ item }}"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
      loop: "{{ drift_networks_extra_in_nb }}"
      when: delete_prefixes_missing_in_infoblox | default(false)
      register: nb_prefix_delete_lookup

    - name: Delete extra prefixes (require 204)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/prefixes/{{ prefix_id }}"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: DELETE
        status_code: [204]
      vars:
        prefix_id: "{{ (item.json.results | map(attribute='id') | list | first) | default('') }}"
      loop: "{{ nb_prefix_delete_lookup.results | default([]) }}"
      when:
        - delete_prefixes_missing_in_infoblox | default(false)
        - prefix_id | length > 0
      register: nb_prefix_deletes

    - name: Resolve NetBox VLAN IDs for deletion (by vid)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/vlans/?vid={{ item }}"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
      loop: "{{ drift_vlans_extra_in_nb }}"
      when: delete_vlans_missing_in_infoblox | default(false)
      register: nb_vlan_delete_lookup

    - name: Delete extra VLANs (require 204)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/vlans/{{ vlan_id }}"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: DELETE
        status_code: [204]
      vars:
        vlan_id: "{{ (item.json.results | map(attribute='id') | list | first) | default('') }}"
      loop: "{{ nb_vlan_delete_lookup.results | default([]) }}"
      when:
        - delete_vlans_missing_in_infoblox | default(false)
        - vlan_id | length > 0
      register: nb_vlan_deletes

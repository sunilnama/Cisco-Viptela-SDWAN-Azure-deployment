
---
- name: Quick debug of mapping vars (no changes)
  hosts: localhost
  gather_facts: false
  connection: local

  vars_files:
    # If you keep common variables in a vars file, include it here:
    # - vars/common.yml

  vars:
    # Import the same variables you used for the main play
    netbox_url: "https://<NETBOX>"
    netbox_token: "<TOKEN>"
    netbox_verify_ssl: false
    infoblox_host: "https://<INFOBLOX>"
    infoblox_username: "<USER>"
    infoblox_password: "<PASS>"
    infoblox_wapi_version: "2.11"

    # If these were previously set in the play, set them here too
    ib_vlan_net_refs: "{{ hostvars['localhost']['ib_vlan_net_refs'] | default([]) }}"
    ib_net_vlan_map:  "{{ hostvars['localhost']['ib_net_vlan_map']  | default({}) }}"
    ib_net_vlan_pairs: "{{ hostvars['localhost']['ib_net_vlan_pairs'] | default([]) }}"
    nb_headers:
      Authorization: "Token {{ netbox_token }}"
      Content-Type: "application/json"

  tasks:
    - name: DEBUG | ib_vlan_net_refs (first few entries)
      debug:
        msg: "{{ ib_vlan_net_refs | slice(0,10) }}"

    - name: DEBUG | ib_net_vlan_map sample
      debug:
        msg: "{{ ib_net_vlan_map | dict2items | slice(0,10) }}"


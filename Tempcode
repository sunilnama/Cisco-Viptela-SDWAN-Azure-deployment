---
- name: Sync Infoblox IPAM data to NetBox (collection-free; version & data drift checks)
  hosts: localhost
  gather_facts: false
  connection: local

  vars:
    # NetBox request headers (token required for /api/*)
    nb_headers:
      Authorization: "Token {{ netbox_token }}"
      Content-Type: "application/json"

    # Tunables for Infoblox paging/limits
    ib_safe_max_results: 500     # lower value to avoid grid limits
    ib_paging_enabled: true

    # Candidate WAPI versions to probe (first supported wins).
    # If you already know your version, set infoblox_wapi_version in group_vars to a single value.
    ib_wapi_candidates_default:
      - "2.14.1"
      - "2.14"
      - "2.13.7"
      - "2.13"
      - "2.12"
      - "2.11"
      - "2.10"

  tasks:
    ###########################################################################
    # NetBox readiness + version drift (read API-Version header)
    ###########################################################################
    - name: Probe NetBox API root (readiness + version header)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
        timeout: 60
        follow_redirects: all
        use_proxy: no
      register: nb_root

    - name: Assert NetBox API is reachable
      ansible.builtin.assert:
        that:
          - nb_root.status == 200
        fail_msg: "NetBox API root not reachable at {{ netbox_url }}/api/"

    # Normalize 'API-Version' header (nb_root.api_version) to X.Y.Z
    - name: Normalize NetBox API-Version header to semver (X.Y.Z)
      ansible.builtin.set_fact:
        nb_api_version_semver: >-
          {{ nb_root.api_version ~ ('.0' if (nb_root.api_version.split('.') | length == 2) else '') }}

    # Normalize baseline and compare versions
    - name: Enforce minimum NetBox version (normalized semver)
      vars:
        min_nb_semver: >-
          {{ min_netbox_version ~ ('.0' if (min_netbox_version.split('.') | length == 2) else '') }}
      ansible.builtin.assert:
        that:
          - nb_api_version_semver is version(min_nb_semver, '>=')
        fail_msg: >-
          NetBox version too old: got {{ nb_api_version_semver }}, need >= {{ min_nb_semver }}.

    - name: Show parsed NetBox API-Version header
      ansible.builtin.debug:
        msg: "NetBox API-Version = {{ nb_root.api_version | default('missing') }} (normalized: {{ nb_api_version_semver }})"

    ###########################################################################
    # Resolve Infoblox WAPI version dynamically
    ###########################################################################
    - name: Build WAPI versions list to probe
      ansible.builtin.set_fact:
        ib_wapi_candidates: >-
          {{ (infoblox_wapi_version | default('')) | ternary([infoblox_wapi_version], ib_wapi_candidates_default) }}

    - name: Probe Infoblox WAPI 'network' schema for each candidate
      ansible.builtin.uri:
        url: "{{ infoblox_host }}/wapi/v{{ item }}/network?_schema"
        user: "{{ infoblox_username }}"
        password: "{{ infoblox_password }}"
        force_basic_auth: true
        validate_certs: "{{ infoblox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200, 401]   # 401 still proves endpoint exists
        timeout: 20
        use_proxy: no
      loop: "{{ ib_wapi_candidates }}"
      register: ib_probe
      failed_when: false

    - name: Resolve supported WAPI version
      ansible.builtin.set_fact:
        ib_wapi_version_resolved: >-
          {{ (ib_probe.results
              | selectattr('status','in',[200,401])
              | map(attribute='item') | list | first) | default('') }}

    - name: Assert we found a supported WAPI version
      ansible.builtin.assert:
        that:
          - ib_wapi_version_resolved | length > 0
        fail_msg: >-
          Could not resolve any supported Infoblox WAPI version from candidates={{ ib_wapi_candidates }}.
          Try hitting {{ infoblox_host }}/wapi/ (no version) to list supported versions, then set infoblox_wapi_version.

    - name: Show resolved WAPI version
      ansible.builtin.debug:
        msg: "Using Infoblox WAPI v{{ ib_wapi_version_resolved }}"

    ###########################################################################
    # Read from Infoblox WAPI (networks) with safe _max_results and paging fallback
    ###########################################################################
    - block:
        - name: Get Infoblox networks (CIDRs) with safe _max_results
          ansible.builtin.uri:
            url: "{{ infoblox_host }}/wapi/v{{ ib_wapi_version_resolved }}/network?_return_fields=network&_max_results={{ ib_safe_max_results }}"
            headers:
              Accept: "application/json"
            user: "{{ infoblox_username }}"
            password: "{{ infoblox_password }}"
            force_basic_auth: true
            validate_certs: "{{ infoblox_verify_ssl }}"
            method: GET
            return_content: true
            timeout: 60
            follow_redirects: all
            use_proxy: no
          register: ib_networks
          failed_when: ib_networks.status != 200

      rescue:
        - name: Show WAPI error body (networks first attempt)
          ansible.builtin.debug:
            msg: "Infoblox networks request failed ({{ ib_networks.status | default('unknown') }}): {{ ib_networks.content | default('no body returned') }}"

        - name: Get Infoblox networks with paging enabled (first page)
          ansible.builtin.uri:
            url: "{{ infoblox_host }}/wapi/v{{ ib_wapi_version_resolved }}/network?_return_fields=network&_paging=1&_max_results={{ ib_safe_max_results }}"
            headers:
              Accept: "application/json"
            user: "{{ infoblox_username }}"
            password: "{{ infoblox_password }}"
            force_basic_auth: true
            validate_certs: "{{ infoblox_verify_ssl }}"
            method: GET
            return_content: true
            timeout: 60
            use_proxy: no
          register: ib_net_page1

        - name: Initialize aggregated network list from first page
          ansible.builtin.set_fact:
            ib_network_pages: "{{ ib_net_page1.json.result | default(ib_net_page1.json | default([])) }}"
            ib_next_page_id: "{{ ib_net_page1.json.next_page_id | default('') }}"

        - name: Fetch additional pages while next_page_id exists
          ansible.builtin.uri:
            url: "{{ infoblox_host }}/wapi/v{{ ib_wapi_version_resolved }}/network?_return_fields=network&_paging=1&_page_id={{ ib_next_page_id }}"
            headers:
              Accept: "application/json"
            user: "{{ infoblox_username }}"
            password: "{{ infoblox_password }}"
            force_basic_auth: true
            validate_certs: "{{ infoblox_verify_ssl }}"
            method: GET
            return_content: true
            timeout: 60
            use_proxy: no
          register: ib_net_pageN
          when: ib_next_page_id != ''
          until: ib_net_pageN.json.next_page_id | default('') == ''
          retries: 20
          delay: 1

        - name: Append subsequent pages to aggregated list (if any)
          ansible.builtin.set_fact:
            ib_network_pages: >-
              {{ ib_network_pages
                 + ( (ib_net_pageN.results | map(attribute='json') | map(attribute='result') | list | flatten)
                     if (ib_net_pageN is defined and ib_net_pageN.results is defined) else [] ) }}

        - name: Convert aggregated pages to ib_networks.json shape
          ansible.builtin.set_fact:
            ib_networks:
              json: "{{ ib_network_pages }}"

    ###########################################################################
    # Read from Infoblox WAPI (fixed addresses) with same strategy
    ###########################################################################
    - block:
        - name: Get Infoblox fixed addresses (static IPs) with safe _max_results
          ansible.builtin.uri:
            url: "{{ infoblox_host }}/wapi/v{{ ib_wapi_version_resolved }}/fixedaddress?_return_fields=ip_address,name&_max_results={{ ib_safe_max_results }}"
            headers:
              Accept: "application/json"
            user: "{{ infoblox_username }}"
            password: "{{ infoblox_password }}"
            force_basic_auth: true
            validate_certs: "{{ infoblox_verify_ssl }}"
            method: GET
            return_content: true
            timeout: 60
            follow_redirects: all
            use_proxy: no
          register: ib_fixed
          failed_when: ib_fixed.status != 200

      rescue:
        - name: Show WAPI error body (fixedaddress first attempt)
          ansible.builtin.debug:
            msg: "Infoblox fixedaddress request failed ({{ ib_fixed.status | default('unknown') }}): {{ ib_fixed.content | default('no body returned') }}"

        - name: Get Infoblox fixed addresses with paging enabled (first page)
          ansible.builtin.uri:
            url: "{{ infoblox_host }}/wapi/v{{ ib_wapi_version_resolved }}/fixedaddress?_return_fields=ip_address,name&_paging=1&_max_results={{ ib_safe_max_results }}"
            headers:
              Accept: "application/json"
            user: "{{ infoblox_username }}"
            password: "{{ infoblox_password }}"
            force_basic_auth: true
            validate_certs: "{{ infoblox_verify_ssl }}"
            method: GET
            return_content: true
            timeout: 60
            use_proxy: no
          register: ib_fix_page1

        - name: Initialize aggregated fixedaddress list from first page
          ansible.builtin.set_fact:
            ib_fixed_pages: "{{ ib_fix_page1.json.result | default(ib_fix_page1.json | default([])) }}"
            ib_next_fix_page_id: "{{ ib_fix_page1.json.next_page_id | default('') }}"

        - name: Fetch additional pages while next_page_id exists (fixedaddress)
          ansible.builtin.uri:
            url: "{{ infoblox_host }}/wapi/v{{ ib_wapi_version_resolved }}/fixedaddress?_return_fields=ip_address,name&_paging=1&_page_id={{ ib_next_fix_page_id }}"
            headers:
              Accept: "application/json"
            user: "{{ infoblox_username }}"
            password: "{{ infoblox_password }}"
            force_basic_auth: true
            validate_certs: "{{ infoblox_verify_ssl }}"
            method: GET
            return_content: true
            timeout: 60
            use_proxy: no
          register: ib_fix_pageN
          when: ib_next_fix_page_id != ''
          until: ib_fix_pageN.json.next_page_id | default('') == ''
          retries: 20
          delay: 1

        - name: Append subsequent pages to aggregated fixedaddress list (if any)
          ansible.builtin.set_fact:
            ib_fixed_pages: >-
              {{ ib_fixed_pages
                 + ( (ib_fix_pageN.results | map(attribute='json') | map(attribute='result') | list | flatten)
                     if (ib_fix_pageN is defined and ib_fix_pageN.results is defined) else [] ) }}

        - name: Convert aggregated pages to ib_fixed.json shape
          ansible.builtin.set_fact:
            ib_fixed:
              json: "{{ ib_fixed_pages }}"

    ###########################################################################
    # Read from NetBox REST (token required)
    ###########################################################################
    - name: Get NetBox prefixes (all)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/prefixes/?limit=0"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        timeout: 60
        follow_redirects: all
        use_proxy: no
      register: nb_prefixes

    - name: Get NetBox IP addresses (all)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/ip-addresses/?limit=0"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        timeout: 60
        follow_redirects: all
        use_proxy: no
      register: nb_ips

    ###########################################################################
    # Normalize lists and compute drift
    ###########################################################################
    - name: Build Infoblox network list (CIDRs)
      ansible.builtin.set_fact:
        ib_network_list: "{{ ib_networks.json | map(attribute='network') | list | default([]) }}"

    - name: Build NetBox prefix list (CIDRs)
      ansible.builtin.set_fact:
        nb_prefix_list: "{{ (nb_prefixes.json.results | map(attribute='prefix') | list) | default([]) }}"

    - name: Build Infoblox fixed IP list
      ansible.builtin.set_fact:
        ib_ip_list: "{{ ib_fixed.json | map(attribute='ip_address') | list | default([]) }}"

    - name: Build NetBox IP list (strip CIDR mask)
      ansible.builtin.set_fact:
        nb_ip_list: "{{ (nb_ips.json.results | map(attribute='address') | map('regex_replace','/\\d+$','') | list) | default([]) }}"

    - name: Compute network drift
      ansible.builtin.set_fact:
        drift_networks_missing_in_nb: "{{ ib_network_list | difference(nb_prefix_list) }}"
        drift_networks_extra_in_nb: "{{ nb_prefix_list | difference(ib_network_list) }}"

    - name: Compute IP drift
      ansible.builtin.set_fact:
        drift_ips_missing_in_nb: "{{ ib_ip_list | difference(nb_ip_list) }}"
        drift_ips_extra_in_nb: "{{ nb_ip_list | difference(ib_ip_list) }}"

    - name: Show drift summary
      ansible.builtin.debug:
        msg:
          - "Networks missing in NetBox: {{ drift_networks_missing_in_nb | length }}"
          - "Networks extra in NetBox:  {{ drift_networks_extra_in_nb | length }}"
          - "IPs missing in NetBox:     {{ drift_ips_missing_in_nb | length }}"
          - "IPs extra in NetBox:       {{ drift_ips_extra_in_nb | length }}"

    - name: Save drift report to /tmp/drift_report.json
      ansible.builtin.copy:
        dest: /tmp/drift_report.json
        content: "{{ {
          'networks_missing_in_netbox': drift_networks_missing_in_nb,
          'networks_extra_in_netbox': drift_networks_extra_in_nb,
          'ips_missing_in_netbox': drift_ips_missing_in_nb,
          'ips_extra_in_netbox': drift_ips_extra_in_nb
        } | to_nice_json }}"

    ###########################################################################
    # Optional remediation (create missing in NetBox via REST)
    ###########################################################################
    - name: Create missing prefixes in NetBox (optional)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/prefixes/"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: POST
        body_format: json
        body:
          prefix: "{{ item }}"
          status: "active"
          description: "Imported from Infoblox"
        status_code: [201]
        timeout: 60
        follow_redirects: all
        use_proxy: no
      loop: "{{ drift_networks_missing_in_nb }}"
      when: remediate_prefixes | default(false)

    - name: Create missing IPs in NetBox (optional)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/ip-addresses/"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: POST
        body_format: json
        body:
          address: "{{ item }}/32"
          status: "active"
          description: "Imported from Infoblox (fixed-address)"
        status_code: [201]
        timeout: 60
        follow_redirects: all
        use_proxy: no
      loop: "{{ drift_ips_missing_in_nb }}"
      when: remediate_ips | default(false)


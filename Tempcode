---
- name: Sync Infoblox IPAM data to NetBox (prefixes, IPs, VLANs) + drift create/patch/delete
  hosts: localhost
  gather_facts: false
  connection: local

  vars:
    ib_host: "{{ infoblox_host | regex_replace('/+$', '') }}"
    ib_wapi_ver: "{{ (infoblox_wapi_version | default('2.11')) | regex_replace('^v', '') }}"
    ib_base: "{{ ib_host }}/wapi/v{{ ib_wapi_ver }}"

    nb_headers:
      Authorization: "Token {{ netbox_token }}"
      Content-Type: "application/json"

    ib_safe_max_results: 500

    remediate_prefixes: true
    remediate_ips: true
    remediate_vlans: true
    patch_prefix_vlan: true

    delete_prefixes_missing_in_infoblox: true
    delete_vlans_missing_in_infoblox: false

    netbox_vlan_site: ""
    min_netbox_version: "3.5"

  tasks:
    - name: Probe NetBox API root (readiness + version header)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
        timeout: 60
        follow_redirects: all
        use_proxy: no
      register: nb_root

    - name: Assert NetBox API is reachable
      ansible.builtin.assert:
        that:
          - nb_root.status == 200
        fail_msg: "NetBox API root not reachable at {{ netbox_url }}/api/"

    - name: Extract NetBox API version from headers (if exposed)
      ansible.builtin.set_fact:
        nb_api_version_raw: "{{ (nb_root.headers | default({}))['API-Version'] | default((nb_root.headers | default({}))['api-version'] | default('')) }}"

    - name: Normalize NetBox API-Version header to semver (X.Y.Z)
      ansible.builtin.set_fact:
        nb_api_version_semver: "{{ nb_api_version_raw ~ ('.0' if (nb_api_version_raw.split('.') | length == 2) else '') }}"
      when: nb_api_version_raw | length > 0

    - name: Normalize baseline (min_netbox_version) to semver (X.Y.Z)
      ansible.builtin.set_fact:
        min_nb_semver: "{{ min_netbox_version ~ ('.0' if (min_netbox_version.split('.') | length == 2) else '') }}"

    - name: Enforce minimum NetBox version (normalized semver)
      ansible.builtin.assert:
        that:
          - nb_api_version_semver is version(min_nb_semver, '>=')
        fail_msg: "NetBox version too old: got {{ nb_api_version_semver }}, need >= {{ min_nb_semver }}."
      when: nb_api_version_raw | length > 0

    - name: Debug Infoblox base URL parts
      ansible.builtin.debug:
        msg:
          - "ib_host={{ ib_host }}"
          - "ib_wapi_ver={{ ib_wapi_ver }}"
          - "ib_base={{ ib_base }}"

    # ----------------- Infoblox fetch -----------------
    - name: Get Infoblox networks (CIDRs only)
      ansible.builtin.uri:
        url: "{{ ib_base }}/network?_return_fields=network&_max_results={{ ib_safe_max_results }}"
        headers: { Accept: "application/json" }
        url_username: "{{ infoblox_username }}"
        url_password: "{{ infoblox_password }}"
        force_basic_auth: true
        validate_certs: "{{ infoblox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
        timeout: 60
        follow_redirects: none
        use_proxy: no
      register: ib_networks

    - name: Get Infoblox fixed addresses (ipv4addr,name)
      ansible.builtin.uri:
        url: "{{ ib_base }}/fixedaddress?_return_fields=ipv4addr,name&_max_results={{ ib_safe_max_results }}"
        headers: { Accept: "application/json" }
        url_username: "{{ infoblox_username }}"
        url_password: "{{ infoblox_password }}"
        force_basic_auth: true
        validate_certs: "{{ infoblox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
        timeout: 60
        follow_redirects: none
        use_proxy: no
      register: ib_fixed

    - name: Get Infoblox VLANs (include assigned_to refs)
      ansible.builtin.uri:
        url: "{{ ib_base }}/vlan?_return_fields=id,name,parent,description,assigned_to&_max_results={{ ib_safe_max_results }}"
        headers: { Accept: "application/json" }
        url_username: "{{ infoblox_username }}"
        url_password: "{{ infoblox_password }}"
        force_basic_auth: true
        validate_certs: "{{ infoblox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
        timeout: 60
        follow_redirects: none
        use_proxy: no
      register: ib_vlans

    # ----------------- NetBox reads -----------------
    - name: Get NetBox prefixes (all)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/prefixes/?limit=0"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
        timeout: 60
        follow_redirects: all
        use_proxy: no
      register: nb_prefixes

    - name: Get NetBox IP addresses (all)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/ip-addresses/?limit=0"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
        timeout: 60
        follow_redirects: all
        use_proxy: no
      register: nb_ips

    - name: Get NetBox VLANs (all)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/vlans/?limit=0"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
        timeout: 60
        follow_redirects: all
        use_proxy: no
      register: nb_vlans

    # ----------------- Build lists -----------------
    - name: Build Infoblox network & IP lists
      ansible.builtin.set_fact:
        ib_network_list: "{{ ib_networks.json | map(attribute='network') | list | default([]) }}"
        ib_ip_list: "{{ ib_fixed.json | map(attribute='ipv4addr') | list | default([]) }}"

    - name: Build Infoblox VLAN vid list (from id)
      ansible.builtin.set_fact:
        ib_vlan_vid_list: "{{ ib_vlans.json | map(attribute='id') | list | default([]) }}"

    # ----------------- Build network→vlan pairs using VLAN.assigned_to (no block+loop) -----------------
    - name: Initialize flat list of assigned refs
      ansible.builtin.set_fact:
        ib_vlan_net_refs: []

    - name: Collect {ref, vid} from VLAN.assigned_to (subelements)
      ansible.builtin.set_fact:
        ib_vlan_net_refs: "{{ (ib_vlan_net_refs | default([])) + [ {'ref': ref_to_use, 'vid': (item.0.id | int)} ] }}"
      vars:
        ref_to_use: "{{ item.1.network | default(item.1.ipv6network | default('')) }}"
      loop: "{{ ib_vlans.json | default([]) | subelements('assigned_to', skip_missing=True) }}"
      when: ref_to_use | length > 0

    - name: Debug assigned refs
      ansible.builtin.debug:
        var: ib_vlan_net_refs

    - name: Fetch CIDR for each assigned ref
      ansible.builtin.uri:
        url: "{{ ib_base }}/{{ item.ref }}?_return_fields=network"
        headers: { Accept: "application/json" }
        url_username: "{{ infoblox_username }}"
        url_password: "{{ infoblox_password }}"
        force_basic_auth: true
        validate_certs: "{{ infoblox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
        timeout: 30
        follow_redirects: none
        use_proxy: no
      loop: "{{ ib_vlan_net_refs }}"
      loop_control:
        label: "{{ item.ref }}"
      register: ib_vlan_assigned_cidrs

    - name: Build network→vid map from fetched CIDRs
      ansible.builtin.set_fact:
        ib_net_vlan_map: "{{ ib_net_vlan_map | default({}) | combine( { (item.json.network): ( ib_vlan_net_refs[ (loop.index0) ].vid ) } ) }}"
      loop: "{{ ib_vlan_assigned_cidrs.results | default([]) }}"

    - name: Debug network→vlan map (from assigned_to)
      ansible.builtin.debug:
        var: ib_net_vlan_map

    - name: Initialize pairs list for prefix→vlan patch
      ansible.builtin.set_fact:
        ib_net_vlan_pairs: []

    - name: Collect (network, vlan_vid) pairs
      ansible.builtin.set_fact:
        ib_net_vlan_pairs: "{{ ib_net_vlan_pairs + [ {'network': item.key, 'vid': item.value} ] }}"
      loop: "{{ ib_net_vlan_map | dict2items }}"

    - name: Debug pairs to patch
      ansible.builtin.debug:
        var: ib_net_vlan_pairs

    # ----------------- NetBox drift lists -----------------
    - name: Build NetBox lists
      ansible.builtin.set_fact:
        nb_prefix_list: "{{ (nb_prefixes.json.results | map(attribute='prefix') | list) | default([]) }}"
        nb_ip_list: "{{ (nb_ips.json.results | map(attribute='address') | map('regex_replace','/\\d+$','') | list) | default([]) }}"
        nb_vlan_vid_list: "{{ nb_vlans.json.results | map(attribute='vid') | list | default([]) }}"

    - name: Compute drift (prefixes, IPs, VLANs)
      ansible.builtin.set_fact:
        drift_networks_missing_in_nb: "{{ ib_network_list | difference(nb_prefix_list) }}"
        drift_networks_extra_in_nb:   "{{ nb_prefix_list | difference(ib_network_list) }}"
        drift_ips_missing_in_nb:      "{{ ib_ip_list | difference(nb_ip_list) }}"
        drift_ips_extra_in_nb:        "{{ nb_ip_list | difference(ib_ip_list) }}"
        drift_vlans_missing_in_nb:    "{{ ib_vlan_vid_list | difference(nb_vlan_vid_list) }}"
        drift_vlans_extra_in_nb:      "{{ nb_vlan_vid_list | difference(ib_vlan_vid_list) }}"

    # ----------------- CREATE -----------------
    - name: Check if prefix exists (NetBox)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/prefixes/?prefix={{ item }}"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
      loop: "{{ drift_networks_missing_in_nb }}"
      register: nb_prefix_checks

    - name: Create missing prefixes (with description)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/prefixes/"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: POST
        body_format: json
        body:
          prefix: "{{ item }}"
          status: "active"
          description: "Imported from Infoblox"
        status_code: [201]
        return_content: true
      loop: "{{ drift_networks_missing_in_nb }}"
      when: >
        (remediate_prefixes | default(true)) and
        ((nb_prefix_checks.results
          | selectattr('item','equalto', item)
          | map(attribute='json')
          | map(attribute='count')
          | list
          | first
          | int) == 0)
      register: nb_prefix_creates

    - name: Check if IP exists (NetBox)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/ip-addresses/?address={{ item }}/32"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
      loop: "{{ drift_ips_missing_in_nb }}"
      register: nb_ip_checks

    - name: Create missing IPs (with description)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/ip-addresses/"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: POST
        body_format: json
        body:
          address: "{{ item }}/32"
          status: "active"
          description: "Imported from Infoblox"
        status_code: [201]
        return_content: true
      loop: "{{ drift_ips_missing_in_nb }}"
      when: >
        (remediate_ips | default(true)) and
        ((nb_ip_checks.results
          | selectattr('item','equalto', item)
          | map(attribute='json')
          | map(attribute='count')
          | list
          | first
          | int) == 0)
      register: nb_ip_creates

    - name: Check if VLAN exists in NetBox by vid (optionally site)
      ansible.builtin.uri:
        url: >-
          {{ netbox_url }}/api/ipam/vlans/?vid={{ item.vid }}
          {% if netbox_vlan_site is defined and netbox_vlan_site|length > 0 %}
          &site={{ netbox_vlan_site | urlencode }}
          {% endif %}
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
      loop: "{{ ib_net_vlan_pairs }}"
      register: nb_vlan_lookup_pairs

    - name: Lookup NetBox Prefix by network (for vlan patch)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/prefixes/?prefix={{ item.network }}"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
      loop: "{{ ib_net_vlan_pairs }}"
      register: nb_prefix_lookup_pairs

    - name: Assert VLAN lookup is unique per item
      ansible.builtin.assert:
        that:
          - item.json.count | int == 1
        fail_msg: >-
          VLAN lookup for {{ item.item.vid }} returned {{ item.json.count | int }} result(s).
          {% if item.json.count | int > 1 %}
          Multiple VLANs share the vid. Constrain by site using `netbox_vlan_site` or ensure unique vids.
          {% else %}
          No VLAN found; create it first or verify vid mapping from Infoblox.
          {% endif %}
      loop: "{{ nb_vlan_lookup_pairs.results | default([]) }}"

    - name: Assert Prefix lookup is unique per item
      ansible.builtin.assert:
        that:
          - item.json.count | int == 1
        fail_msg: >-
          Prefix lookup for {{ item.item.network }} returned {{ item.json.count | int }} result(s).
          Ensure the prefix exists and is unique.
      loop: "{{ nb_prefix_lookup_pairs.results | default([]) }}"

    - name: PATCH prefix → set VLAN (use VLAN primary key id) and description
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/prefixes/{{ nb_prefix_id }}/"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: PATCH
        body_format: json
        body:
          vlan: "{{ nb_vlan_pk | int }}"
          description: "Imported from Infoblox"
        status_code: [200]
        return_content: true
      vars:
        nb_vlan_pk: >-
          {{
            (
              nb_vlan_lookup_pairs.results
              | selectattr('item.network','equalto', item.network)
              | selectattr('item.vid','equalto', item.vid)
              | map(attribute='json')
              | map(attribute='results')
              | list
              | first
              | default([])
            )
            | map(attribute='id')
            | first
            | default(0)
          }}
        nb_prefix_id: >-
          {{
            (
              nb_prefix_lookup_pairs.results
              | selectattr('item.network','equalto', item.network)
              | map(attribute='json')
              | map(attribute='results')
              | list
              | first
              | default([])
            )
            | map(attribute='id')
            | first
            | default('')
          }}
      loop: "{{ ib_net_vlan_pairs }}"
      loop_control:
        label: "prefix={{ item.network }} → vid={{ item.vid }}"
      when:
        - nb_vlan_pk | int > 0
        - nb_prefix_id | length > 0
      register: nb_prefix_vlan_patches

    - name: Show PREFIX→VLAN patch summary
      ansible.builtin.debug:
        msg:
          - "Pairs considered: {{ ib_net_vlan_pairs | length }}"
          - "Patched count: {{ (nb_prefix_vlan_patches.results | selectattr('status','equalto',200) | list | length) if nb_prefix_vlan_patches is defined else 0 }}"
          - "Failures: {{ (nb_prefix_vlan_patches.results | rejectattr('status','equalto',200) | list | length) if nb_prefix_vlan_patches is defined else 0 }}"

    # ----------------- OPTIONAL description patches -----------------
    - name: Patch description on VLANs missing description (optional)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/vlans/{{ item.id }}"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: PATCH
        body_format: json
        body:
          description: "Imported from Infoblox"
        status_code: [200]
      loop: "{{ nb_vlans.json.results | default([]) }}"
      when: (item.description | default('')) | length == 0

    - name: Patch description on prefixes missing description (optional)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/prefixes/{{ item.id }}"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: PATCH
        body_format: json
        body:
          description: "Imported from Infoblox"
        status_code: [200]
      loop: "{{ nb_prefixes.json.results | default([]) }}"
      when: (item.description | default('')) | length == 0

    # ----------------- DELETE (optional) -----------------
    - name: Resolve NetBox prefix IDs for deletion
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/prefixes/?prefix={{ item }}"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
      loop: "{{ drift_networks_extra_in_nb }}"
      when: delete_prefixes_missing_in_infoblox | default(false)
      register: nb_prefix_delete_lookup

    - name: Delete extra prefixes (require 204)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/prefixes/{{ prefix_id }}"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: DELETE
        status_code: [204]
      vars:
        prefix_id: "{{ (item.json.results | map(attribute='id') | list | first) | default('') }}"
      loop: "{{ nb_prefix_delete_lookup.results | default([]) }}"
      when:
        - delete_prefixes_missing_in_infoblox | default(false)
        - prefix_id | length > 0
      register: nb_prefix_deletes

    - name: Resolve NetBox VLAN IDs for deletion (by vid)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/vlans/?vid={{ item }}"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: GET
        return_content: true
        status_code: [200]
      loop: "{{ drift_vlans_extra_in_nb }}"
      when: delete_vlans_missing_in_infoblox | default(false)
      register: nb_vlan_delete_lookup

    - name: Delete extra VLANs (require 204)
      ansible.builtin.uri:
        url: "{{ netbox_url }}/api/ipam/vlans/{{ vlan_id }}"
        headers: "{{ nb_headers }}"
        validate_certs: "{{ netbox_verify_ssl }}"
        method: DELETE
        status_code: [204]
      vars:
        vlan_id: "{{ (item.json.results | map(attribute='id') | list | first) | default('') }}"
      loop: "{{ nb_vlan_delete_lookup.results | default([]) }}"
      when:
        - delete_vlans_missing_in_infoblox | default(false)
        - vlan_id | length > 0
      register: nb_vlan_deletes
